def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'LocationWhenInUse',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'contributors_app' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # -------------------------------------------------------------
    # NUEVA CONFIGURACIÓN: Limpieza de alertas y Non-Modular Includes
    # -------------------------------------------------------------
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Evita el error de "non-modular include in framework module"
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Desactiva que las advertencias se traten como errores fatales
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end
    # -------------------------------------------------------------

    # Fix for Xcode 26 / Apple Clang 21 (build ver >= 17000000): consteval is broken in fmt.
    # Patch fmt/base.h to disable FMT_USE_CONSTEVAL for Xcode 26+ (Apple Clang >= 17000000).
    fmt_base_h = File.join(installer.config.project_pods_root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      old_check = '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L'
      new_check = '#elif defined(__apple_build_version__) && (__apple_build_version__ < 14000029L || __apple_build_version__ >= 17000000L)'
      if content.include?(old_check)
        File.write(fmt_base_h, content.gsub(old_check, new_check))
        Pod::UI.puts '[Podfile] Patched fmt/base.h for Xcode 26 (Apple Clang 21+) consteval compatibility.'
      end
    end
  end
end
