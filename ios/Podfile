def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'LocationWhenInUse',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'contributors_app' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # -------------------------------------------------------------
    # NUEVA CONFIGURACIÓN: Limpieza de alertas y Non-Modular Includes
    # -------------------------------------------------------------
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        # Xcode 26 enables explicit modules by default; CocoaPods module maps
        # don't exist in DerivedData until pods compile, causing fatal scan failures.
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end
    # -------------------------------------------------------------

    # Fix for Xcode 26: 4 pods (NitroModules, RNNitroSQLite, RNScreens, VisionCamera) have their
    # -fmodule-map-file flags pointing to PODS_CONFIGURATION_BUILD_DIR (DerivedData), which doesn't
    # exist before those pods compile. Rewrite them to the static Target Support Files paths so
    # Clang can load them at dependency-scan time without the pods needing to be built first.
    pods_with_derived_modulemaps = %w[NitroModules RNNitroSQLite RNScreens VisionCamera]
    ['debug', 'release'].each do |config_name|
      xcconfig_path = File.join(
        installer.config.sandbox.target_support_files_root,
        'Pods-contributors_app',
        "Pods-contributors_app.#{config_name}.xcconfig"
      )
      next unless File.exist?(xcconfig_path)
      content = File.read(xcconfig_path)
      pods_with_derived_modulemaps.each do |pod|
        derived = "-fmodule-map-file=\"${PODS_CONFIGURATION_BUILD_DIR}/#{pod}/#{pod}.modulemap\""
        static  = "-fmodule-map-file=\"${PODS_ROOT}/Target Support Files/#{pod}/#{pod}.modulemap\""
        content = content.gsub(derived, static)
        # Swift flags use -Xcc prefix
        derived_xcc = "-Xcc -fmodule-map-file=\"${PODS_CONFIGURATION_BUILD_DIR}/#{pod}/#{pod}.modulemap\""
        static_xcc  = "-Xcc -fmodule-map-file=\"${PODS_ROOT}/Target Support Files/#{pod}/#{pod}.modulemap\""
        content = content.gsub(derived_xcc, static_xcc)
      end
      File.write(xcconfig_path, content)
    end
    Pod::UI.puts '[Podfile] Rewrote NitroModules/RNNitroSQLite/RNScreens/VisionCamera modulemap paths to static PODS_ROOT locations.'

    # Fix for Xcode 26 / Apple Clang 21 (build ver >= 17000000): consteval is broken in fmt.
    # Patch fmt/base.h to disable FMT_USE_CONSTEVAL for Xcode 26+ (Apple Clang >= 17000000).
    fmt_base_h = File.join(installer.config.project_pods_root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      old_check = '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L'
      new_check = '#elif defined(__apple_build_version__) && (__apple_build_version__ < 14000029L || __apple_build_version__ >= 17000000L)'
      if content.include?(old_check)
        File.write(fmt_base_h, content.gsub(old_check, new_check))
        Pod::UI.puts '[Podfile] Patched fmt/base.h for Xcode 26 (Apple Clang 21+) consteval compatibility.'
      end
    end
  end
end
