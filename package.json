{
  "name": "contributors_app",
  "version": "1.0.12",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:fresh": "react-native start --reset-cache",
    "ios:dev": "cross-env ENV_APP=debug react-native run-ios",
    "ios:prod": "cross-env ENV_APP=release react-native run-ios --mode Release --device",
    "android:dev": "cross-env ANDROID_HOME=$HOME/Library/Android/sdk ENV_APP=debug react-native run-android",
    "build:android:dev": "cross-env ANDROID_HOME=$HOME/Library/Android/sdk ENV_APP=debug react-native build-android --mode=release",
    "build:android:prod": "cross-env ANDROID_HOME=$HOME/Library/Android/sdk ENV_APP=release react-native build-android --mode=release",
    "apk:dev": "cross-env ENV_APP=debug sh -c 'cd android && ./gradlew assembleDebug'",
    "apk:prod": "cross-env ENV_APP=release sh -c 'cd android && ./gradlew assembleRelease'",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/drawer": "^7.7.8",
    "@react-navigation/elements": "^2.9.1",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/stack": "^7.6.11",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.15.2",
    "contributors_app": "file:",
    "date-fns": "^4.1.0",
    "nativewind": "^2.0.11",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-android-location-enabler": "^3.0.1",
    "react-native-android-open-settings": "^1.3.0",
    "react-native-device-info": "^13.0.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.20.1",
    "react-native-modal": "^13.0.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-nitro-sqlite": "^9.6.0",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-select-dropdown": "^4.0.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
